{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "C: build",
            "type": "shell",
            "command": "gcc",
            "args": [
                "-Wall",
                "-Wextra",
                "-g",
                "-std=c17",
                "main.c",
                "file.c",
                "menu.c",
                "list.c",
                "str.c",
                "utile.c",
                "-o",
                "c-project"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": ["$gcc"],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        }
    ]
}
